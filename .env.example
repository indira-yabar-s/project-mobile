# Base URL of the Gamarrito backend (include /api/v1).
# Android emulator -> http://10.0.2.2:8080/api/v1
# Physical device  -> http://<your-LAN-IP>:8080/api/v1
# For EAS builds and updates this value is not read from .env: create it with
#   eas env:set --name EXPO_PUBLIC_API_URL --value <url> --environment preview --visibility plaintext
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080/api/v1
